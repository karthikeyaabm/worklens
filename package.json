{
  "name": "worklens",
  "version": "1.2.0",
  "description": "WorkLens | Employee Timelog & Activity Tracking",
  "author": "ABM Knowledgeware Ltd.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "watchdog": "node watchdog/watchdog.js",
    "test": "node run_all_tests.js",
    "test:all": "node run_all_tests.js",
    "test:offline": "electron test_offline_suite.js",
    "test:storage": "electron test_storage_health_suite.js",
    "test:teams": "node test_teams_tracking_suite.js",
    "test:location": "electron test_location_suite.js",
    "test:sessions": "electron test_session_times_suite.js",
    "test:periods": "node test_activity_periods_suite.js",
    "test:progressive": "electron test_progressive_loading.js",
    "test:watchdog": "node scratch/test_watchdog_suite.js",
    "build": "electron-builder",
    "release": "electron-builder --publish always"
  },
  "devDependencies": {
    "electron": "^42.4.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.worklens.desktop",
    "productName": "WorkLens",
    "icon": "assets/icon.png",
    "files": [
      "**/*"
    ],
    "extraResources": [
      {
        "from": ".env",
        "to": ".env"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": true,
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh"
    },
    "publish": {
      "provider": "github",
      "owner": "karthikeyaabm",
      "repo": "worklens",
      "releaseType": "release"
    }
  },
  "dependencies": {
    "active-win": "^8.2.1",
    "dotenv": "^16.4.5",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "uiohook-napi": "^1.5.5"
  }
}